generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  username String 
  password String
  profilePicture String?
  university String?
  academicYear Int?
  phoneNumber String?
  friends String[]
}
