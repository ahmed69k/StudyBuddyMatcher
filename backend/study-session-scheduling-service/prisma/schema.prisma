// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionType {
  ONLINE
  IN_PERSON
}

model StudySession {
  id          String              @id @default(uuid())
  topic       String
  description String?
  dateTime    DateTime
  duration    Int
  sessionType SessionType
  creatorId   String
  contactInfo String?
  /// Set when the “starting soon” reminder was sent to participants.
  upcomingReminderSentAt DateTime?
  participants SessionParticipant[]
  invites      StudySessionInvite[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([dateTime, upcomingReminderSentAt])
}

/// Buddy invited at create time — visible in their list but not a participant until they join.
model StudySessionInvite {
  id            String       @id @default(uuid())
  sessionId     String
  session       StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  inviteeUserId String
  createdAt     DateTime     @default(now())

  @@unique([sessionId, inviteeUserId])
  @@index([inviteeUserId])
}

model SessionParticipant {
  id        String       @id @default(uuid())
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  userId    String
  joinedAt  DateTime     @default(now())

  @@unique([sessionId, userId])
}
