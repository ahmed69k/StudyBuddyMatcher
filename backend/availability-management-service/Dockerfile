# ORIGINAL: NO DOCKERFILE IN REPO FOR THIS SERVICE
# EDIT: DOCKERFILE ADDED FOR DOCKER COMPOSE / GATEWAY DEPLOY
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx prisma generate

# ORIGINAL: NO EXPOSE LINE (FILE DID NOT EXIST)
# EDIT: MUST MATCH SERVICE PORT (TEAM SCHEME: 3002)
EXPOSE 3002

CMD ["npm", "run", "start"]
