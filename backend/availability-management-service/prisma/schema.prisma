// Prisma schema for availability-management-service
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Availability {
  id        String   @id @default(uuid())
  userId    String
  dayOfWeek String
  startHour Int
  endHour   Int
  createdAt DateTime @default(now())
}

